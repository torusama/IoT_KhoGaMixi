# Copy with `npm run configure` to generate local development credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=1880
API_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_EDITOR=false
# Optional bcrypt hash, required to enable the editor outside loopback.
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD_HASH=
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_CA_FILE=
DEVICE_ID=esp32_01
DEVICE_MQTT_PASSWORD=
STORE_DRIVER=file
STORE_FILE=.runtime/store.json
FIREBASE_PROJECT_ID=demo-spt
FIREBASE_DATABASE_URL=
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/untracked-service-account.json
FIREBASE_ROOT=spt
HEARTBEAT_STALE_MS=6000
HEARTBEAT_OFFLINE_MS=15000
COMMAND_TIMEOUT_MS=10000
COMMAND_RETRY_MS=2000
KEYFRAME_INTERVAL_MS=5000
